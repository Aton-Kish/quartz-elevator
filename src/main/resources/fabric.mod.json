{
  "schemaVersion": 1,
  "id": "quartzelv",
  "version": "${version}",

  "name": "Quartz Elevator",
  "description": "Adds quartz elevators.",
  "authors": ["Aton-Kish"],
  "contact": {
    "homepage": "https://github.com/Aton-Kish/quartz-elevator",
    "sources": "https://github.com/Aton-Kish/quartz-elevator"
  },

  "license": "MIT",
  "icon": "assets/quartzelv/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": ["atonkish.quartzelv.QuartzElevatorMod"],
    "fabric-gametest": [
      "atonkish.quartzelv.gametest.QuartzElevatorModGameTest"
    ],
    "modmenu": ["atonkish.quartzelv.integration.modmenu.ModMenu"]
  },
  "mixins": ["quartzelv.mixins.json"],
  "accessWidener": "quartzelv.accesswidener",

  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.6",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
